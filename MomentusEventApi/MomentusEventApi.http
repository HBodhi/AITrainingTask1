@MomentusEventApi_HostAddress = http://localhost:5001

# Get all events
GET {{MomentusEventApi_HostAddress}}/api/events
Accept: application/json

###

# Get specific event by ID
GET {{MomentusEventApi_HostAddress}}/api/events/1
Accept: application/json

###

# Get non-existent event (test 404)
GET {{MomentusEventApi_HostAddress}}/api/events/999
Accept: application/json

###

# Search all events (no filter)
GET {{MomentusEventApi_HostAddress}}/api/events/search
Accept: application/json

###

# Search events with filter
GET {{MomentusEventApi_HostAddress}}/api/events/search?filter=Conference
Accept: application/json

###

# Search events with OData filter (for real Ungerboeck API)
GET {{MomentusEventApi_HostAddress}}/api/events/search?filter=Description eq 'Tech Conference 2026'
Accept: application/json

###
